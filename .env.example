# Copy this file to .env and fill in real values. Never commit .env.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=hirelucent
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hirelucent
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MINUTES=60

# --- LLM ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=change_me

# --- Embeddings (Ollama) ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_BASE_URL=http://ollama:11434

# --- ChromaDB ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# --- First interviewer account (created automatically at startup) ---
SEED_INTERVIEWER_EMAIL=interviewer@example.com
SEED_INTERVIEWER_PASSWORD=change_me
SEED_INTERVIEWER_NAME=Demo Interviewer