# Copy this file to .env and fill in real values. Never commit .env.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=hirelucent
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hirelucent
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MINUTES=60

# --- LLM ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=change_me

# --- Embeddings (Ollama) ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_BASE_URL=http://ollama:11434

# --- ChromaDB ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# --- First interviewer account (created automatically at startup) ---
SEED_INTERVIEWER_EMAIL=interviewer@example.com
SEED_INTERVIEWER_PASSWORD=change_me
SEED_INTERVIEWER_NAME=Demo Interviewer


OPENAI_API_KEY=
AI_TIMEOUT_SECONDS=60

# Requests per minute: a little under the provider's limit (15 for the
# Gemini free tier). Screening may use at most the second number, so the
# AI Agent and the interview room always have room.
LLM_REQUESTS_PER_MINUTE=14
LLM_BACKGROUND_REQUESTS_PER_MINUTE=10

# --- RAG MCP server ---
MCP_RAG_URL=http://mcp-rag:8001/mcp
JD_REFERENCE_MAX_DISTANCE=0.6

# --- Blogger MCP server (publishes approved job posts) ---
# The Google sign-in files live in secrets/, see the README.
MCP_BLOGGER_URL=http://mcp-blogger:8002/mcp
BLOGGER_BLOG_ID=your_blog_id
BLOGGER_API_KEY=change_me

# The Google sign-in file, as seen inside the backend container.
GOOGLE_TOKEN_FILE=/secrets/google_token.json

# --- Google MCP server (interview emails and calendar invitations) ---
# Uses the same Google sign-in. The sender address is the Gmail account
# you signed in with; leave it empty and Gmail fills it in.
MCP_GOOGLE_URL=http://mcp-google:8003/mcp
EMAIL_SENDER_NAME=HireLucent Careers
EMAIL_SENDER_ADDRESS=

# --- LiveKit video server ---
# The browser connects to LIVEKIT_URL. The key and secret are shared by the
# livekit and backend services; the secret must be at least 32 characters.
LIVEKIT_URL=ws://localhost:7880
# The same server as the backend container reaches it (to close rooms).
LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change_me_to_a_random_string_of_32_or_more_chars

# --- Interviews ---
# How many minutes before the start a candidate can join.
JOIN_OPENS_MINUTES_BEFORE=10
# How far ahead an interview must be scheduled. While testing, use 1 here
# and 60 above to schedule and join almost at once.
INTERVIEW_MIN_NOTICE_MINUTES=15
# Time zone for interview emails and for times typed to the AI Agent.
APP_TIMEZONE=Asia/Dhaka
# The web app's address, used in the join links sent to candidates.
FRONTEND_BASE_URL=http://localhost:3000
